{
  "fuzzy_compare": true,
  "evaluation_interval": "10s",
  "tests": [{
    "name": "SlimFaas autoscaling expressions",
    "interval": "10s",
    "input_series": [
      {"series": "queue{job=\"kafka\",topic=\"api,v1\"}", "values": "500 0 6 3 9 999"},
      {"series": "queue{job=\"kafka\",topic=\"events\"}", "values": "90 2 2 2 2 999"},
      {"series": "queue{topic=\"events\"}", "values": "100 5 5 5 5 999"},
      {"series": "limit{topic=\"events\",job=\"kafka\"}", "values": "4 4 4 4 4"},
      {"series": "requests_total", "values": "900 3 13 2 12 999"},
      {"series": "sparse_total", "values": "_ _ 20 30 _ _"},
      {"series": "recent_total", "values": "_ _ 0 10 20 _"},
      {"series": "latency_bucket{le=\"0.5\"}", "values": "10 20 30 40 50"},
      {"series": "latency_bucket{le=\"1\"}", "values": "20 40 60 80 100"},
      {"series": "latency_bucket{le=\"+Inf\"}", "values": "30 60 90 120 150"}
    ],
    "promql_expr_test": [
      {"expr": "sum(queue)", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 16}]},
      {"expr": "sum(max_over_time(queue[40s]))", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 16}]},
      {"expr": "sum(avg_over_time(queue[40s]))", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 11.5}]},
      {"expr": "sum(min_over_time(queue[40s]))", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 7}]},
      {"expr": "sum(sum_over_time(queue[40s]))", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 46}]},
      {"expr": "sum(count_over_time(queue[40s]))", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 12}]},
      {"expr": "sum(last_over_time(queue[40s]))", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 16}]},
      {"expr": "max(avg(queue) by (job))", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 5.5}]},
      {"expr": "count(sum by (job, topic) (queue))", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 3}]},
      {"expr": "sum(queue{job!=\"kafka\"})", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 5}]},
      {"expr": "sum(queue{job=\"\"})", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 5}]},
      {"expr": "sum(queue{topic!~\"events|api\"})", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 9}]},
      {"expr": "sum(queue{topic=~\"api|vents\"})", "eval_time": "40s", "exp_samples": []},
      {"expr": "sum(queue{topic=\"api,v1\"})", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 9}]},
      {"expr": "sum(queue / limit)", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 0.5}]},
      {"expr": "sum(2 + queue)", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 22}]},
      {"expr": "sum(queue >= 5)", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 14}]},
      {"expr": "sum(queue >= bool 5)", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 2}]},
      {"expr": "sum(rate(requests_total[40s]))", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 0.625}]},
      {"expr": "sum(increase(requests_total[40s]))", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 25}]},
      {"expr": "sum(irate(requests_total[40s]))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 0.2}]},
      {"expr": "sum(rate(sparse_total[40s]))", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 0.625}]},
      {"expr": "sum(rate(recent_total[40s]))", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 0.5}]},
      {"expr": "sum(rate(recent_total[10s]))", "eval_time": "40s", "exp_samples": []},
      {"expr": "histogram_quantile(0.5, sum by (le) (rate(latency_bucket[40s])))", "eval_time": "40s", "exp_samples": [{"labels": "{}", "value": 0.75}]}
    ]
  }, {
    "name": "Numerical reductions, regex classes and one-to-one matching",
    "interval": "10s",
    "input_series": [
      {"series": "errors{job=\"api\",pod=\"idle\"}", "values": "0 0 0 0"},
      {"series": "requests{job=\"api\",pod=\"idle\"}", "values": "0 0 0 0"},
      {"series": "errors{job=\"api\",pod=\"busy\"}", "values": "2 2 2 2"},
      {"series": "requests{job=\"api\",pod=\"busy\"}", "values": "10 10 10 10"},
      {"series": "large{pod=\"a\"}", "values": "1e308 1e308 1e308 1e308"},
      {"series": "large{pod=\"b\"}", "values": "1e308 1e308 1e308 1e308"},
      {"series": "net_change", "values": "0 1e16 1 -1e16"},
      {"series": "http_errors{code=\"500\"}", "values": "2 2 2 2"},
      {"series": "http_errors{code=\"٥٠٠\"}", "values": "7 7 7 7"},
      {"series": "capacity{job=\"api\",pool=\"primary\"}", "values": "20 20 20 20"},
      {"series": "queue_jobs{queue=\"a\",zone=\"n\"}", "values": "4 4 4 4"},
      {"series": "queue_jobs{queue=\"b\",zone=\"n\"}", "values": "6 6 6 6"},
      {"series": "workers{queue=\"a\",source=\"poll\"}", "values": "2 2 2 2"},
      {"series": "workers{queue=\"b\",source=\"poll\"}", "values": "3 3 3 3"},
      {"series": "change{job=\"a\",i=\"1\"}", "values": "1e16"},
      {"series": "change{job=\"a\",i=\"2\"}", "values": "1"},
      {"series": "change{job=\"a\",i=\"3\"}", "values": "-1e16"}
    ],
    "promql_expr_test": [
      {"expr": "max(max by (job) (errors / requests))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 0.2}]},
      {"expr": "min(min by (job) (errors / requests))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 0.2}]},
      {"expr": "avg(large)", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 1e+308}]},
      {"expr": "max(avg_over_time(large[30s]))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 1e+308}]},
      {"expr": "sum(sum_over_time(net_change[30s]))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 1}]},
      {"expr": "sum(avg_over_time(net_change[30s]))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 0.3333333333333333}]},
      {"expr": "sum(http_errors{code=~\"[[:digit:]]{3}\"})", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 2}]},
      {"expr": "sum(http_errors{code=~\"\\\\d{3}\"})", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 2}]},
      {"expr": "sum(clamp_min(requests, 1))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 11}]},
      {"expr": "sum(sum without (pod) (requests))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 10}]},
      {"expr": "sum(present_over_time(requests[30s]))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 2}]},
      {"expr": "sum(sum by (job) (errors) / on (job) sum by (job) (requests))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 0.2}]},
      {"expr": "sum(change)", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 1}]},
      {"expr": "sum(sum by (job) (change))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 1}]},
      {"expr": "avg(change)", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 0.3333333333333333}]},
      {"expr": "sum(avg by (job) (change))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 0.3333333333333333}]},
      {"expr": "sum(avg without (pod) (large))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 1e+308}]},
      {"expr": "sum(clamp_min(errors{pod=\"idle\"}, 1+1))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 2}]},
      {"expr": "sum(clamp_min(missing, 1))", "eval_time": "30s", "exp_samples": []},
      {"expr": "sum(present_over_time(errors{pod=\"idle\"}[30s]))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 1}]},
      {"expr": "sum(present_over_time(missing[30s]))", "eval_time": "30s", "exp_samples": []},
      {"expr": "sum(queue_jobs / on (queue) workers)", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 4}]},
      {"expr": "sum(queue_jobs / ignoring (source, zone) workers)", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 4}]},
      {"expr": "sum((queue_jobs / on(queue) workers) * on(queue) workers)", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 10}]},
      {"expr": "sum(sum(requests) without(pod) / on(job) capacity)", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 0.5}]},
      {"expr": "sum(queue_jobs > bool on(queue) workers)", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 2}]},
      {"expr": "sum(queue_jobs > on(queue) workers)", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 10}]},
      {"expr": "sum(errors{pod=\"idle\"} / on(job) workers{queue=\"none\"})", "eval_time": "30s", "exp_samples": []},
      {"expr": "sum(http_errors{code!~\"\\\\D+\"})", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 2}]},
      {"expr": "sum(http_errors{code!~\"[[:alpha:]]+\"})", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 9}]},
      {"expr": "sum(http_errors{code=~\"[[:xdigit:]]{3}\"})", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 2}]},
      {"expr": "sum(http_errors{code=~\"[[:alnum:]]{3}\"})", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 2}]},
      {"expr": "count(max by (job) (errors{pod=\"idle\"} / requests{pod=\"idle\"}))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 1}]},
      {"expr": "sum((max by (job) (errors{pod=\"idle\"} / requests{pod=\"idle\"})) != bool (max by (job) (errors{pod=\"idle\"} / requests{pod=\"idle\"})))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 1}]},
      {"expr": "count(max by(job)(missing / requests))", "eval_time": "30s", "exp_samples": []},
      {"expr": "sum((errors / requests) == bool (errors / requests))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 1}]},
      {"expr": "sum((errors / requests) != bool (errors / requests))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 1}]},
      {"expr": "sum(requests{pod=\"idle\"} == bool -0)", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 1}]},
      {"expr": "sum(requests{pod=\"busy\"} / 10 == bool 1.0000000000000002)", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 0}]},
      {"expr": "sum(requests{pod=\"busy\"} / 10 < bool 1.0000000000000002)", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 1}]},
      {"expr": "sum(requests{pod=\"busy\"} / 0 == bool (1 / 0))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 1}]},
      {"expr": "sum(requests{pod=\"busy\"} / 0 > bool (-1 / 0))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 1}]},
      {"expr": "sum(requests <= bool (0 / 0))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 0}]},
      {"expr": "sum((0 / 0) >= bool requests)", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 0}]},
      {"expr": "sum(requests != (0 / 0))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 10}]},
      {"expr": "sum(sum without() (errors))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 2}]},
      {"expr": "sum(sum by() (errors) / on() sum(requests))", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 0.2}]},
      {"expr": "sum(http_errors{code=~\"[5[:alpha:]][[:digit:]]{2}\"})", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 2}]},
      {"expr": "sum(http_errors{code=~\"[\\\\d]{3}\"})", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 2}]},
      {"expr": "sum(http_errors{code=~\"[^[:digit:]]{3}\"})", "eval_time": "30s", "exp_samples": [{"labels": "{}", "value": 7}]},
      {"expr": "sum(present_over_time(missing[10s]))", "eval_time": "30s", "exp_samples": []}
    ]
  }]
}
