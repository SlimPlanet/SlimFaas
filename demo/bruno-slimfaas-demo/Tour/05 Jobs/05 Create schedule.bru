meta {
  name: Create schedule
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/job-schedules/fibonacci
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"Schedule":"0 0 1 1 *","Args":["10"]}
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) bru.setVar("scheduleId", res.getBody().Id);
}

tests {
  test("Expected HTTP status", function () {
    expect([201]).to.include(res.getStatus());
  });
}

docs {
  Run the Tour folder in order. See https://slimfaas.dev/guided-tour and https://slimfaas.dev/api-reference.
  The response captures scheduleId for later requests and cleanup.
}
