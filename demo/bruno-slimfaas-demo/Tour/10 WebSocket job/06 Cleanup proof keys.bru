meta {
  name: Delete only proof keys and keep the worker and Stream
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/data/sets/{{wsFunction}}-async
  body: none
  auth: none
}

tests {
  test("Proof cleanup does not stop the persistent worker or delete history", async function () {
    expect([204, 404]).to.include(res.getStatus());
    const response = await bru.sendRequest({ method: "DELETE", url: bru.getEnvVar("baseUrl") + "/data/sets/" + bru.getVar("wsFunction") + "-stream" }).catch(error => {
      if (error.status === 404 || error.response?.status === 404) return { status: 404 };
      throw error;
    });
    expect([204, 404]).to.include(response.status);
    const registration = await bru.sendRequest({ method: "DELETE", url: bru.getEnvVar("baseUrl") + "/data/sets/" + bru.getVar("wsFunction") + "-ready" }).catch(error => {
      if (error.status === 404 || error.response?.status === 404) return { status: 404 };
      throw error;
    });
    expect([204, 404]).to.include(registration.status);
    console.log("Keep job " + bru.getVar("wsJobId") + " connected; manually DELETE /job/fibonacci-ws/" + bru.getVar("wsJobId") + " when finished, then DELETE /data/streams/" + bru.getVar("wsStream"));
  });
}

docs {
  Registration, async and Stream proof keys also expire after ten minutes. Job and Stream/history are intentionally retained.
  A second run creates another distinct worker; a third run fails the two-job capacity check until explicit manual cleanup.
}
