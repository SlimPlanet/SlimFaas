meta {
  name: Inspect immutable original body
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/data/dead-letters/fibonacci1/messages/{{durableDlqId}}/body
  body: none
  auth: none
}

tests {
  test("Body belongs to this run", async function () {
    let response = { status: res.getStatus(), data: res.getBody() };
    const deadline = Date.now() + 10000;
    while (response.status === 404 && Date.now() < deadline) {
      await bru.sleep(200);
      response = await bru.sendRequest({ method: "GET", url: req.getUrl() }).catch(error => {
        if (error.status === 404 || error.response?.status === 404) return { status: 404, data: null };
        throw error;
      });
    }
    expect(response.status).to.equal(200);
    expect(response.data.orderId).to.equal(bru.getVar("durableId"));
  });
}
