meta {
  name: Publish once and observe two independent ACKs
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/publish-stream/orders/compute
  body: json
  auth: none
}

body:json {
  {"orderId":"{{durableId}}","amount":42}
}

tests {
  test("Durable append is followed by both consumer ACKs", async function () {
    expect(res.getStatus()).to.equal(201);
    const id = res.getBody().MessageId;
    expect(id).to.match(/^[a-f0-9]+_[0-9]{20}$/);
    bru.setVar("durableStreamId", id);
    const sequence = Number(id.split("_").pop());
    const url = bru.getEnvVar("baseUrl") + "/data/streams/orders/functions";
    const deadline = Date.now() + 180000;
    let response;
    const complete = r => r.status === 200 && ["fibonacci1", "fibonacci2"].every(name =>
      r.data.Items.some(item => item.Function === name && item.Active && item.AcknowledgedThrough >= sequence));
    do {
      response = await bru.sendRequest({ method: "GET", url });
      expect(response.status).to.equal(200);
      if (complete(response)) break;
      await bru.sleep(500);
    } while (Date.now() < deadline);
    expect(complete(response), "Append 201 alone is not processing success").to.equal(true);
  });
}
