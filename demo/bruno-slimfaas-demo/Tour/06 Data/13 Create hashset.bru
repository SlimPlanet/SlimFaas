meta {
  name: Create hashset
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/data/hashsets?ttl=300000
  body: text
  auth: none
}

headers {
  Content-Type: text/plain
}

body:text {
  hashset sample
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) bru.setVar("hashId", res.getBody());
}

tests {
  test("Expected HTTP status", function () {
    expect([200]).to.include(res.getStatus());
  });
}

docs {
  Run the Tour folder in order. See https://slimfaas.dev/guided-tour and https://slimfaas.dev/api-reference.
  The response captures hashId for later requests and cleanup.
}
