# TEMPORARY suppression list for the analyzer rollout (https://github.com/SlimPlanet/SlimFaas/issues/358).
#
# Every rule listed here still has occurrences in the code base as of 2026-09-11 (count in the comment).
# The build is green only because of this file. Each remediation PR fixes the occurrences of one or
# more rules and DELETES the corresponding lines. Never add a rule here: new code must be clean.
# The file is removed entirely at the end of the rollout.
is_global = true
global_level = 90

