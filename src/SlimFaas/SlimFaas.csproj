<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>SlimFaas</RootNamespace>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <StripSymbols>true</StripSymbols>
    <PublishAot>true</PublishAot>
    <DebuggerSupport>false</DebuggerSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <!-- Metadata updates are disabled; do not emit .NET 11 browser Hot Reload assets. -->
    <EnableHotReloadInRuntimeConfigDevFile>false</EnableHotReloadInRuntimeConfigDevFile>
    <StackTraceSupport>true</StackTraceSupport>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <PropertyGroup>
    <IlcGenerateMstatFile>true</IlcGenerateMstatFile>
    <IlcGenerateDgmlFile>true</IlcGenerateDgmlFile>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <!-- Disable multi-threading to avoid InvalidCastException with QEMU emulation -->
    <IlcMultiThreaded>false</IlcMultiThreaded>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KubernetesClient.Aot" />
    <PackageReference Include="MemoryPack" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="prometheus-net" />
    <PackageReference Include="prometheus-net.AspNetCore" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="ZLinq" />
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SlimData\SlimData.csproj" />
    <InternalsVisibleTo Include="SlimFaas.Tests" />
    <InternalsVisibleTo Include="SlimFaas.Benchmarks" />
    <InternalsVisibleTo Include="SlimFaas.CollectionProbe" />
  </ItemGroup>

  <!-- ASP.NET Core 11.0.0 has an incorrectly scoped Blazor substitutions resource.
       Suppress only that framework assembly's XML-owner diagnostic; application
       trim/AOT diagnostics remain errors. Remove when the upstream resource is fixed. -->
  <ItemGroup Condition="'$(NETCoreSdkVersion)' == '11.0.100' And '$(PublishAot)' != 'true'">
    <_ILLinkSuppressions Include="$(MSBuildThisFileDirectory)ILLink.FrameworkSuppressions.xml" />
  </ItemGroup>

  <!-- Build Vite/React dashboard into wwwroot -->
  <PropertyGroup>
    <ClientAppDir>ClientApp</ClientAppDir>
    <!-- Storybook output is a development fixture, not runtime content. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp/storybook-static/**</DefaultItemExcludes>
    <SkipClientAppBuild Condition="'$(SkipClientAppBuild)' == ''">false</SkipClientAppBuild>
  </PropertyGroup>

  <Target Name="NpmInstall" BeforeTargets="NpmBuild" Condition="'$(SkipClientAppBuild)' != 'true' AND !Exists('$(ClientAppDir)/node_modules')">
    <Exec WorkingDirectory="$(ClientAppDir)" Command="npm ci" />
  </Target>

  <Target Name="NpmBuild" BeforeTargets="BeforeBuild" Condition="'$(SkipClientAppBuild)' != 'true'">
    <ItemGroup>
      <_PreviousDashboardAssets Include="wwwroot/**" />
    </ItemGroup>
    <Exec WorkingDirectory="$(ClientAppDir)" Command="npm run build" />
    <!-- Vite replaces hashed assets after project evaluation. Refresh the items so
         incremental builds and the first clean build publish the current files. -->
    <ItemGroup>
      <Content Remove="@(_PreviousDashboardAssets)" />
      <Content Include="wwwroot/**" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

</Project>
