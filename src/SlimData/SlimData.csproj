<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <StripSymbols>false</StripSymbols>
        <PublishAot>true</PublishAot>
        <OptimizationPreference>Size</OptimizationPreference>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DotNext.AspNetCore.Cluster" />
        <PackageReference Include="MemoryPack" />
        <PackageReference Include="Moq" />
        <PackageReference Include="ZLinq" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SlimData.Tests" />
        <InternalsVisibleTo Include="SlimFaas.Benchmarks" />
        <InternalsVisibleTo Include="SlimFaas.CollectionProbe" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="ThirdPartyNotices/DotNext.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
