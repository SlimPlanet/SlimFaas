{
  "name": "slimfaas-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-assets.mts && next dev --turbopack",
    "build": "node scripts/prepare-assets.mts && next build && node scripts/generate-sitemap.mts && node scripts/check-export.mts",
    "start": "next start",
    "lint": "eslint .",
    "deploy": "gh-pages -d out",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/documentation.test.mts",
    "check:export": "node scripts/check-export.mts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "gh-pages": "^6.3.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "mermaid": "^11.17.2",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-svg": "^19.1.5",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "sass": "^1.103.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.10"
    }
  },
  "type": "module"
}
